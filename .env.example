# Application
APP_NAME=PyLake
APP_ENV=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Backend
DATABASE_URL=postgresql+psycopg://pylake:pylake@localhost:5432/pylake
SQLITE_DATABASE_URL=sqlite:///./pylake.db
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=104857600
STORAGE_BACKEND=local
PARQUET_COMPRESSION=snappy
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RETURNED_ROWS=1000
SQL_MAX_RESULT_BYTES=10485760
PIPELINE_JOB_CLAIM_SECONDS=300
PIPELINE_WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
PIPELINE_STEP_TIMEOUT_SECONDS=300
PIPELINE_MAX_RETRIES=3
WORKER_STALE_SECONDS=90

# Authentication
AUTH_SECRET=change-this-secret-before-production
AUTH_COOKIE_NAME=pylake_session
CSRF_COOKIE_NAME=pylake_csrf
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pylake
MINIO_SECRET_KEY=pylake-local-secret
MINIO_BUCKET=pylake
MINIO_SECURE=false

# AI Copilot is disabled unless explicitly configured.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
NVIDIA_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_ENABLE_THINKING=true
AI_REASONING_BUDGET=2048
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_INPUT_CHARS=30000
AI_MAX_HISTORY_MESSAGES=12
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_DAILY_TOKEN_LIMIT=100000

# To use NVIDIA Nemotron, set AI_PROVIDER=nvidia, AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b,
# and AI_BASE_URL=https://integrate.api.nvidia.com/v1. Keep NVIDIA_API_KEY server-side.
