# Application
APP_NAME=PyLake
APP_ENV=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Backend
DATABASE_URL=postgresql+psycopg://pylake:pylake@localhost:5432/pylake
SQLITE_DATABASE_URL=sqlite:///./pylake.db
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=104857600
STORAGE_BACKEND=local
PARQUET_COMPRESSION=snappy
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RETURNED_ROWS=1000
SQL_MAX_RESULT_BYTES=10485760

# Authentication
AUTH_SECRET=change-this-secret-before-production
AUTH_COOKIE_NAME=pylake_session
CSRF_COOKIE_NAME=pylake_csrf
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pylake
MINIO_SECRET_KEY=pylake-local-secret
MINIO_BUCKET=pylake
MINIO_SECURE=false
